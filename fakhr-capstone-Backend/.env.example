# Local-only backend template. Supply your own local replica-set database.
NODE_ENV=development
PORT=8000
MONGODB_URI=
JWT_SECRET=
OPENAI_API_KEY=
# The validated transport uses this dedicated key, not OPENAI_API_KEY.
FAKHR_AI_OPENAI_API_KEY=
FAKHR_AI_LEDGER_ANCHOR=
FAKHR_AI_LEDGER_SIGNING_KEY=
FAKHR_AI_WITNESS_URI=
FAKHR_AI_WITNESS_SIGNING_KEY=
# Set only after the operator verifies an isolated, authorized test environment.
FAKHR_AI_ENVIRONMENT=
FAKHR_AI_ENABLED=false
FAKHR_AI_ACCESS=off
FAKHR_RELEASE_PROFILE=minimum-plan
FAKHR_PLAN_DASHBOARD_ENABLED=false
FAKHR_DAILY_CARE_ENABLED=false
SEED_CARE_PATH=false
