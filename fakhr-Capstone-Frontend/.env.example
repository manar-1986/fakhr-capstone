# Fakhr — Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to git (it's in .gitignore)

# API Configuration
#
# Physical device (Expo Go on a real phone): REQUIRED — use your computer's LAN IP + /api
#   macOS: ipconfig getifaddr en0   (example: http://192.168.1.42:8000/api)
#
# Web (localhost:8081): the app uses http://localhost:8000/api in the browser.
# iOS Simulator / Android Emulator: the app uses http://127.0.0.1:8000/api and http://10.0.2.2:8000/api
# automatically in dev, so a stale hotspot IP here won't break the simulator.
# To force this URL on web/emulators too (API on another machine): EXPO_PUBLIC_API_STRICT=1
#
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:8000/api
# EXPO_PUBLIC_API_STRICT=1

# Add other environment variables here as needed
