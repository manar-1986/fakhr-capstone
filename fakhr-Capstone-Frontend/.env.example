# Local-only frontend template. Preview scripts set their own isolated fixture flags.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api
# Do not enable live AI. Staging configuration requires separate approval.

# Select the integrated Plan routes; requires compatible backend configuration.
EXPO_PUBLIC_FAKHR_RELEASE_PROFILE=minimum-plan
EXPO_PUBLIC_API_STRICT=1
# Enable only against an approved local backend with daily-care routes enabled.
EXPO_PUBLIC_DAILY_CARE_ENABLED=false
# Both flags are required for isolated development fixtures. Never use real data.
EXPO_PUBLIC_SMART_PLAN_PREVIEW=false
EXPO_PUBLIC_SMART_PLAN_FIXTURES=false
EXPO_PUBLIC_FAKHR_AI_ACCESS=off